{
  "name": "@epicurrents/core",
  "version": "1.0.3",
  "description": "Epicurrents core library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": "./dist/assets/index.js",
    "./config": "./dist/config/index.js",
    "./events": "./dist/events/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./types": "./dist/types/index.d.ts",
    "./util": "./dist/util/index.js",
    "./workers": "./dist/workers/index.js",
    "./workers/*": "./umd/*",
    "./package.json": "./package.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./dist/assets": "./dist/assets/index.js",
    "./dist/config": "./dist/config/index.js",
    "./dist/events": "./dist/events/index.js",
    "./dist/runtime": "./dist/runtime/index.js",
    "./dist/types": "./dist/types/index.d.ts",
    "./dist/util": "./dist/util/index.js",
    "./dist/workers": "./dist/workers/index.js",
    "./umd/*": "./umd/*"
  },
  "imports": {
    "#runtime*": "./src/runtime/index.ts",
    "#*": "./src/*"
  },
  "files": [
    "dist/*",
    "umd/*.js",
    "LICENSE",
    "README.md",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "npm run build:workers && npm run build:tsc",
    "build:docs": "npx typedoc",
    "build:lib": "vite build",
    "build:tsc": "npm run build:lib && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly && tsconfig-replace-paths --project tsconfig.json",
    "build:workers": "node scripts/build-workers.mjs",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epicurrents/core.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "dependencies": {
    "@stdlib/constants-float16": "^0.2.1",
    "@stdlib/constants-float32": "^0.2.1",
    "@stdlib/constants-float64": "^0.2.1",
    "asymmetric-io-mutex": "^1.0.0",
    "codecutils": "^0.1.3",
    "downsample": "^1.4.0",
    "onnxruntime-web": "^1.14.0",
    "scoped-event-bus": "^0.3.0",
    "scoped-event-log": "^3.2.0",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@microsoft/tsdoc": "^0.14.1",
    "@stylistic/eslint-plugin": "^3.0.0",
    "@stylistic/eslint-plugin-ts": "^3.0.0",
    "@types/node": "^22.10.10",
    "@types/offscreencanvas": "^2019.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.19.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typedoc": "^0.27.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.1"
  }
}
